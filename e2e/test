#!/bin/bash
set -euo pipefail

SNAPSHOT_FILE="/e2e/snapshot.txt"

hosts=("$DIFFICALCY_HOST" "$DIFFICALCY_FULL_HOST")

fetch() {
  echo "${*//$API/}" >> "$OUT"
  curl --fail --silent --show-error "$@" | jq >> "$OUT"
}

outputs=()
for host in "${hosts[@]}"; do
  echo "Testing $host"
  API="http://$host"
  OUT="$(mktemp)"
  outputs+=("$OUT")

  fetch "$API/api/calculators"

  fetch "$API/api/calculators/osu/info"
  fetch "$API/api/calculators/osu/calculation?BeatmapId=diffcalc-test-osu"
  fetch "$API/api/calculators/osu/calculation?BeatmapId=diffcalc-test-osu"
  fetch "$API/api/calculators/osu/calculation?BeatmapId=diffcalc-test-osu&Mods=HD,DT"
  fetch -X POST "$API/api/calculators/osu/batch/calculation" \
    -H "Content-Type: application/json" \
    -d '[{"BeatmapId": "diffcalc-test-osu"}, {"BeatmapId": "diffcalc-test-osu", "Mods": [{"Acronym": "DT"}]}]'
  fetch "$API/api/calculators/osu/beatmapdetails?BeatmapId=diffcalc-test-osu"

  fetch "$API/api/calculators/taiko/info"
  fetch "$API/api/calculators/taiko/calculation?BeatmapId=diffcalc-test-taiko"
  fetch "$API/api/calculators/taiko/calculation?BeatmapId=diffcalc-test-taiko"
  fetch "$API/api/calculators/taiko/calculation?BeatmapId=diffcalc-test-taiko&Mods=HD,DT"
  fetch -X POST "$API/api/calculators/taiko/batch/calculation" \
    -H "Content-Type: application/json" \
    -d '[{"BeatmapId": "diffcalc-test-taiko"}, {"BeatmapId": "diffcalc-test-taiko", "Mods": [{"Acronym": "DT"}]}]'
  fetch "$API/api/calculators/taiko/beatmapdetails?BeatmapId=diffcalc-test-taiko"

  fetch "$API/api/calculators/catch/info"
  fetch "$API/api/calculators/catch/calculation?BeatmapId=diffcalc-test-catch"
  fetch "$API/api/calculators/catch/calculation?BeatmapId=diffcalc-test-catch"
  fetch "$API/api/calculators/catch/calculation?BeatmapId=diffcalc-test-catch&Mods=HD,DT"
  fetch -X POST "$API/api/calculators/catch/batch/calculation" \
    -H "Content-Type: application/json" \
    -d '[{"BeatmapId": "diffcalc-test-catch"}, {"BeatmapId": "diffcalc-test-catch", "Mods": [{"Acronym": "DT"}]}]'
  fetch "$API/api/calculators/catch/beatmapdetails?BeatmapId=diffcalc-test-catch"

  fetch "$API/api/calculators/mania/info"
  fetch "$API/api/calculators/mania/calculation?BeatmapId=diffcalc-test-mania"
  fetch "$API/api/calculators/mania/calculation?BeatmapId=diffcalc-test-mania"
  fetch "$API/api/calculators/mania/calculation?BeatmapId=diffcalc-test-mania&Mods=HD,DT"
  fetch -X POST "$API/api/calculators/mania/batch/calculation" \
    -H "Content-Type: application/json" \
    -d '[{"BeatmapId": "diffcalc-test-mania"}, {"BeatmapId": "diffcalc-test-mania", "Mods": [{"Acronym": "DT"}]}]'
  fetch "$API/api/calculators/mania/beatmapdetails?BeatmapId=diffcalc-test-mania"
done

if [ "${UPDATE_SNAPSHOTS:-false}" = "true" ]; then
  cat "${outputs[0]}" > "$SNAPSHOT_FILE"
  echo "Snapshot updated: $SNAPSHOT_FILE"
  exit 0
fi

for out in "${outputs[@]:1}"; do
  diff -u "${outputs[0]}" "$out"
done
diff -u "$SNAPSHOT_FILE" "${outputs[0]}"
echo "Snapshots match."
